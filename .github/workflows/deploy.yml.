name: Deploy to EC2
on:
  push:
    branches: [main]
concurrency:
  group: deploy
  cancel-in-progress: false
jobs:
  build-and-push:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: docker/login-action@v3
        with:
          username: ${{ secrets.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}
      - uses: docker/build-push-action@v5
        with:
          context: .
          push: true
          tags: |
            ${{ secrets.DOCKERHUB_USERNAME }}/sre-practice-app:latest
            ${{ secrets.DOCKERHUB_USERNAME }}/sre-practice-app:${{ github.sha }}
  deploy:
    needs: build-and-push
    runs-on: ubuntu-latest
    steps:
      - uses: appleboy/ssh-action@v1.0.0
        with:
          host: ${{ secrets.EC2_HOST }}
          username: ${{ secrets.EC2_USERNAME }}
          key: ${{ secrets.EC2_SSH_KEY }}
          script: |
            set -e
            IMAGE=${{ secrets.DOCKERHUB_USERNAME }}/sre-practice-app:${{ github.sha }}
            sudo docker pull $IMAGE
            sudo docker rm -f sre-app || true
            sudo docker run -d --name sre-app --restart unless-stopped -p 8000:8000 $IMAGE
            sleep 5
            curl -fsS http://localhost:8000 || (echo "health check failed"; exit 1)
